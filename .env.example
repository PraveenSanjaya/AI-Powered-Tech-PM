# Copy to .env and fill in. This file contains placeholders only; never commit .env.

# --- Required ---
POSTGRES_PASSWORD=change-me
# Fernet key for encrypting integration credentials. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# --- Optional (defaults shown) ---
POSTGRES_USER=techpm
POSTGRES_DB=techpm
APP_ENV=development            # set to "production" to disable demo seeding
DEMO_MODE=true                 # shows the DEMO banner and allows loading fictional demo integrations
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false            # set true behind HTTPS

# --- LLM (leave as demo to run without any API key) ---
LLM_PROVIDER=demo              # demo | anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# --- Local (non-Docker) development, read by the API ---
# DATABASE_URL=postgresql+psycopg://techpm:change-me@localhost:5432/techpm
# REDIS_URL=redis://localhost:6379/0
# API_INTERNAL_URL=http://localhost:8000   # used by the Next.js dev server to proxy /api

# --- Future live integrations (Stage 2+; not used by this build) ---
# GITHUB_TOKEN=
# JIRA_BASE_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# SLACK_BOT_TOKEN=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# NOTION_TOKEN=
